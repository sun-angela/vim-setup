// Place your key bindings in this file to override the defaults
[
    {
        "key": "cmd+`",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "alt+z",
        "command": "-workbench.action.terminal.sizeToContentWidth",
        "when": "terminalFocus && terminalHasBeenCreated && terminalIsOpen || terminalFocus && terminalIsOpen && terminalProcessSupported"
    },
    {
        "key": "ctrl+alt+cmd+p",
        "command": "workbench.action.toggleEditorWidths"
    },
    {
        "key": "ctrl+alt+cmd+p",
        "command": "workbench.action.toggleMaximizedPanel",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+alt+cmd+e",
        "command": "editor.action.showHover",
        "when": "editorTextFocus"
    },
    {
        "key": "cmd+k cmd+i",
        "command": "-editor.action.showHover",
        "when": "editorTextFocus"
    },
    {
    "key": "tab",
    "command": "runCommands",
    "args": {
        "commands": [
        "hideSuggestWidget",
        "tabout"
        ]
    },
    "when": "editorTextFocus && editorLangId == latex && vim.mode == 'Insert' && suggestWidgetVisible && !inSnippetMode && !editorHasSelection && !editorHasMultipleSelections"
    },
    {
    "key": "tab",
    "command": "tabout",
    "when": "editorTextFocus && !inSnippetMode && !suggestWidgetVisible && !inlineSuggestionVisible && !editorHasMultipleSelections"
    },
    {
    "key": "tab",
    "command": "jumpToNextSnippetPlaceholder",
    "when": "editorTextFocus && inSnippetMode"
    }
]
